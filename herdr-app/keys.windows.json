{
  "global": {
    "ctrl-shift-t": "tab.new",
    "ctrl-shift-w": "tab.close",
    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "ctrl-shift-pagedown": "space.next",
    "ctrl-shift-pageup": "space.prev",
    "ctrl-shift-l": "layout.switch",
    "ctrl-shift-n": "space.new",
    "ctrl-shift-p": "app.palette",
    "ctrl-,": "app.settings",
    "ctrl-shift-d": "pane.split:right",
    "ctrl-shift-e": "pane.split:down",
    "ctrl-shift-x": "pane.close",
    "ctrl-shift-enter": "pane.zoom",
    "ctrl-shift-left": "pane.go:left",
    "ctrl-shift-right": "pane.go:right",
    "ctrl-shift-up": "pane.go:up",
    "ctrl-shift-down": "pane.go:down",
    "f2": "tab.rename",
    "shift-f2": "space.rename",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-b": "layout.toggle:sidebar",
    "ctrl-=": "app.zoom_in",
    "ctrl-+": "app.zoom_in",
    "ctrl--": "app.zoom_out",
    "ctrl-0": "app.zoom_reset",
    "alt-1": "tab.select:1",
    "alt-2": "tab.select:2",
    "alt-3": "tab.select:3",
    "alt-4": "tab.select:4",
    "alt-5": "tab.select:5",
    "alt-6": "tab.select:6",
    "alt-7": "tab.select:7",
    "alt-8": "tab.select:8",
    "alt-9": "tab.select:9",
    "ctrl-1": "space.select:1",
    "ctrl-2": "space.select:2",
    "ctrl-3": "space.select:3",
    "ctrl-4": "space.select:4",
    "ctrl-5": "space.select:5",
    "ctrl-6": "space.select:6",
    "ctrl-7": "space.select:7",
    "ctrl-8": "space.select:8",
    "ctrl-9": "space.select:9",
    "ctrl-a": "mod.open:my-leader"
  },
  "terminal": {
    "ctrl-shift-f": "terminal.search",
    "ctrl-shift-a": "terminal.select_all",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image"
  },
  "mod:leader": {
    ",": "tab.rename",
    "$": "space.rename",
    "(": "space.prev",
    ")": "space.next",
    "s": "mod.open:picker",
    "n": "tab.next",
    "p": "tab.prev",
    "b": "layout.toggle:sidebar",
    "w": "my-spaces.focus",
    "a": "my-agents.focus",
    "t": {"command": "pane.split", "args": {"direction": "right", "mod": "my-tickets"}},
    "u": "mod.open:my-urls",
    "h": "pane.go:left",
    "j": "pane.go:down",
    "k": "pane.go:up",
    "l": "pane.go:right",
    "|": "pane.split:right",
    "z": "pane.zoom",
    "-": "pane.split:down",
    "?": "mod.open:my-help",
    ":": "app.palette",
    "x": "my-status.close-pane",
    "c": "tab.new",
    "shift-c": "space.new",
    "ctrl-a": "send:\u0001"
  }
}
